# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE — PROJETO NASA SPACE APPS CHALLENGE 2026
# ============================================================================
# AVISO DE SEGURANÇA:
# 1. Copie este arquivo para ".env" apenas quando necessário.
# 2. NUNCA insira chaves privadas (API Keys de IA, tokens privados da NASA ou
#    credenciais de banco de dados) em variáveis com o prefixo VITE_*.
#    Variáveis VITE_* são embutidas no pacote JavaScript público enviado ao navegador.
# 3. Chaves de APIs privadas e de Inteligência Artificial deverão residir
#    exclusivamente no servidor Backend (Fase 2).
# ============================================================================

# [FRONTEND PÚBLICO] URL base do futuro servidor Backend (Proxy de APIs e IA)
VITE_API_BASE_URL=http://localhost:3000/api

# [FUTURO BACKEND - APENAS SERVIDOR]
# PORT=3000
# NASA_API_KEY=sua_chave_privada_nasa_aqui
# AI_PROVIDER_API_KEY=sua_chave_privada_ia_aqui
