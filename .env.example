# ============================================================================
# ENVIRONMENT CONFIGURATION — NASA SPACE APPS CHALLENGE 2026 PROJECT
# ============================================================================
# SECURITY NOTICE:
# 1. Copy this file to ".env" only when necessary.
# 2. NEVER insert private keys (AI API keys, private NASA tokens, or
#    database credentials) into variables prefixed with VITE_*.
#    VITE_* variables are bundled into the public JavaScript sent to the browser.
# 3. Private API and Artificial Intelligence keys must reside
#    exclusively on the Backend server (Phase 2).
# ============================================================================

# [PUBLIC FRONTEND] Base URL for the Backend server (API and AI Proxy)
VITE_API_BASE_URL=http://localhost:3000/api

# [BACKEND SERVER ONLY]
# PORT=3000
# NASA_API_KEY=your_private_nasa_key_here
# AI_PROVIDER_API_KEY=your_private_ai_key_here
